scalar Long
scalar LocalDate

type UsageResponse {
hhId: String
offerId: String
count: Long
storeId: String
transactionId: String
transactionTimeStamp: LocalDate
status: String
createdDate: LocalDate
lastUpdatedDate: LocalDate
usageDate: LocalDate
offerEndDate: String
extOfferId: String
laneNumber: Int
source: String
clipIds: [String]
earnPoints: Int
}

input UsageRequest {
hhId: String
offerId: String
count: Long
storeId: String
transactionId: String
transactionTimeStamp: LocalDate
status: String
createdDate: LocalDate
lastUpdatedDate: LocalDate
usageDate: LocalDate
offerEndDate: String
extOfferId: String
laneNumber: Int
source: String
clipIds: [String]
earnPoints: Int
}

type Query {
   healthCheck: String
    getUsageByHhid(hhId: String!): [UsageResponse]
    getUsageByHhidAndOfferId(hhId: String!, offerId: String!): [UsageResponse]
}

type Mutation {
    insertUsage(usageRequest: UsageRequest): UsageResponse
}